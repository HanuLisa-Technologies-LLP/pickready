# ReadyPick — frontend environment template (Next.js).
# Copy to .env.local and fill in real values. All NEXT_PUBLIC_* vars are exposed
# to the browser bundle by design — only put publishable client config here,
# never a secret (the Firebase Web API key is publishable, not a secret).

# Backend API base URL (defaults to http://localhost:8000/api/v1 when unset)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Firebase Web SDK config (client-side auth — Google / Email-Password / Phone).
# Values come from Firebase console → Project settings → Your apps → Web app.
# These identify the project to Firebase; they are safe to ship in the bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Either `<project>.firebaseapp.com` (default) or the site's own host
# (e.g. readypick.ai) to serve the sign-in popup from this origin via the
# /__/auth proxy in next.config.js. Before pointing it at the site host:
# add the host to Firebase Auth authorized domains AND add
# https://<host>/__/auth/handler as an authorized redirect URI on the
# project's Google OAuth client, or Google sign-in fails.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
