diff --git a/backend/tests/test_code_execution_judge0_self_checks.py b/backend/tests/test_code_execution_judge0_self_checks.py
new file mode 100644
index 0000000..b94b3b6
--- /dev/null
+++ b/backend/tests/test_code_execution_judge0_self_checks.py
@@ -0,0 +1,49 @@
+"""The Judge0 adapter's own checks for the operator verification task.
+
+Driven over `httpx.MockTransport` with authored fixtures, like the adapter's
+main test module. What is pinned: an unauthenticated request is really sent
+WITHOUT the token, a host that answers it fails the check, and a configured
+language the host does not offer is named.
+"""
+from __future__ import annotations
+
+import httpx
+
+from app.services.coding_assessment import sweeps
+from tests.test_code_execution_judge0_adapter import TOKEN, Recorder, envelope, provider, respond
+
+
+def _languages(request: httpx.Request) -> httpx.Response:
+    if request.headers.get("X-Auth-Token") != TOKEN:
+        return respond("error_401_unauthorized.json")
+    return respond("languages_200.json")
+
+
+async def test_a_host_that_refuses_strangers_and_offers_every_language_passes() -> None:
+    recorder = Recorder({("GET", "/languages"): _languages})
+    checks = await provider(recorder).self_checks()
+    assert set(checks) == set(sweeps.ADAPTER_CHECK_NAMES)
+    assert all(passed for passed, _detail in checks.values())
+    bare, authed = recorder.requests
+    assert "X-Auth-Token" not in bare.headers and "X-Auth-User" not in bare.headers
+    assert authed.headers["X-Auth-Token"] == TOKEN
+
+
+async def test_a_host_that_answers_without_a_token_fails() -> None:
+    recorder = Recorder({("GET", "/languages"): "languages_200.json"})
+    checks = await provider(recorder).self_checks()
+    assert checks["unauthenticated_refused"][0] is False
+
+
+async def test_a_configured_language_the_host_does_not_offer_is_named() -> None:
+    data = envelope("languages_200.json")
+    without_java = [entry for entry in data["body"] if entry["id"] != 62]
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.headers.get("X-Auth-Token") != TOKEN:
+            return respond("error_401_unauthorized.json")
+        return httpx.Response(200, json=without_java)
+
+    checks = await provider(Recorder({("GET", "/languages"): handler})).self_checks()
+    passed, detail = checks["language_ids_match"]
+    assert passed is False and "java" in detail
