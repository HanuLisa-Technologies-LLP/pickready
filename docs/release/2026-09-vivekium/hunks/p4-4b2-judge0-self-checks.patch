@@ -474,6 +474,50 @@ class Judge0Provider:
                     exc.reason,
                 )
 
+    async def self_checks(self) -> dict[str, tuple[bool, str]]:
+        """The checks only this adapter can make, for the operator's sandbox
+        verification task (`coding_assessment.sweeps.verify_sandbox`).
+
+        NOT part of the port: what they check is wire detail. The verification
+        task asks for it by name and records every check as NOT PERFORMED for
+        a provider that does not offer it, so the verdict cannot be green.
+
+        `unauthenticated_refused`: `GET /languages` WITHOUT the token must be
+        refused (401 or 403). A host that answers it would run anybody's code.
+        `language_ids_match`: every configured language id must be one the
+        host offers, or a Run in that language would be refused at submit.
+        """
+        started = self._clock()
+        try:
+            async with httpx.AsyncClient(
+                base_url=self._base_url, timeout=self._timeout, transport=self._transport
+            ) as client:
+                bare = await client.get("/languages")
+        except httpx.TimeoutException as exc:
+            self._log("self_check_auth", 0, "timeout", started)
+            raise ExecutionUnavailable("sandbox self check timed out", reason="timeout") from exc
+        except httpx.TransportError as exc:
+            self._log("self_check_auth", 0, "network", started)
+            raise ExecutionUnavailable("sandbox self check could not connect", reason="network") from exc
+        self._log("self_check_auth", 0, _status_class(bare.status_code), started)
+        refused = bare.status_code in (401, 403)
+        checks: dict[str, tuple[bool, str]] = {
+            "unauthenticated_refused": (
+                refused,
+                "refused without a token" if refused else f"answered {bare.status_code} without a token",
+            )
+        }
+        payload = self._json(await self._request("languages", "GET", "/languages", batch_size=0), "languages")
+        if not isinstance(payload, list):
+            raise ExecutionRejected("sandbox /languages answer is not a list", reason="protocol")
+        offered = {entry.get("id") for entry in payload if isinstance(entry, dict)}
+        missing = sorted(key for key, language_id in self._language_ids.items() if language_id not in offered)
+        checks["language_ids_match"] = (
+            not missing,
+            "every configured language is offered" if not missing else "not offered: " + ", ".join(missing),
+        )
+        return checks
+
     async def health(self) -> ProviderHealth:
         response = await self._request("health", "GET", "/workers", batch_size=0)
         payload = self._json(response, "health")
