# Secrets — never commit
.env
api-keys.txt
deployment-keys.txt
*-keys.txt

# GCP service account keys. These carry Cloud Run Admin, Cloud SQL Admin and
# Artifact Registry Writer, so a committed key is a full project takeover.
service-account-key.json
*-service-account*.json
gcp-key*.json
application_default_credentials.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
.vercel

# Runtime artifacts
celerybeat-schedule*

# Misc
*.log
.DS_Store

# Deploy output: service URLs and revision names written by scripts/deploy.sh
.deploy-state.env

# CI/CD bootstrap output: contains a live bearer JWT, never commit
.github-secrets-setup.txt

# Terraform working directories. Provider binaries are ~700MB and are
# reproducible from the lock file, so they are downloaded rather than committed.
# The LOCK FILE is committed, deliberately: it pins provider versions, and an
# unpinned provider means two runs of the same config can plan differently.
**/.terraform/
*.tfplan
*.tfstate
*.tfstate.*
# Saved binary plans (`terraform plan -out=tfplan*`) and locally-built Lambda
# zips. Both are reproducible build artifacts, and a saved plan can embed
# resolved secret values.
infra/environments/*/tfplan*
**/.terraform-build/
# REAL VALUES. Every account-specific input lives here and none of it is
# committed: the account id, the globally-unique bucket names, the domain.
# `infra/environments/offline-plan.tfvars` is the exception and IS committed,
# because every value in it is deliberately impossible.
*.tfvars
!infra/environments/offline-plan.tfvars
*.tfvars.json

# ---------------------------------------------------------------------------
# Vendored third-party design skills (spec-doc6 RPN-SPEC-006 §D4).
#
# These are other people's code, with their own licences and their own update
# cadence. Vendoring them here makes provenance and licensing ambiguous and
# bloats the tree; 302 files sat untracked-and-unignored before this rule, so
# a single `git add -A` would have committed all of them.
#
# The environment is reproduced from `tools/design-tools.manifest.json` by
# `tools/install-design-tools.sh` instead. Pin there, not here.
.claude/skills/impeccable/
.claude/skills/design-taste-frontend/
.claude/skills/high-end-visual-design/
.claude/skills/redesign-existing-projects/
.claude/skills/img2threejs/
.claude/skills/animate-expo/
.claude/skills/animate/
.claude/skills/animation-vocabulary/
.claude/skills/apple-design/
.claude/skills/ask-sonner/
.claude/skills/emil-design-eng/
.claude/skills/find-animation-opportunities/
.claude/skills/improve-animations/
.claude/skills/mobile-native/
.claude/skills/pick-ui-library/
.claude/skills/prototype/
.claude/skills/review-animations/
.claude/skills/write-swift/
.github/skills/
.agents/skills/

# Impeccable's own generated agent definitions and hook config. Same D4
# argument as the skill source above: third-party content with its own licence.
# `tools/design-tools.manifest.json` records how to regenerate them, and
# `.impeccable-exceptions.md` (ours, and committed) is where our decisions live.
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json

# A snapshot of which files were untracked at one moment. Stale the instant
# anything is committed; the commit history is the durable record.
UNTRACKED_INVENTORY.md

# Coverage artifacts. `scripts/check-coverage-floors.py` reads the JSON and CI
# regenerates it on every run, so a committed one is a stale number somebody
# will eventually read as the current one.
backend/coverage.json
backend/coverage-full.json
backend/.coverage
backend/.coverage.*
backend/htmlcov/

# Offline-plan scratch copies (infra/plan-offline.sh). Siblings of the real
# environment roots because the module paths are relative; removed on exit.
infra/environments/.*-offline-plan/

# Generated knowledge graph. Reproduced by `graphify update .`, and graph.json
# alone is 800k+ lines: a build artifact, never a source of truth.
graphify-out/

# Harness run artifacts (docs/spec/HARNESS.md section 5). One directory per run
# holding the manifest, the trajectory, captured logs and the reports, plus
# `baselines.json` naming the promoted reference per tier. Evidence of one
# execution on one machine: committing it would put a stale report where the
# next reader takes it for the current one, which is the same argument this
# file already makes about backend/coverage.json. Retention is bounded by
# `--keep-last`, so this directory does not grow without limit.
harness-runs/

# Another coding agent's local state, same argument as the vendored skills
# above: it is tooling on one developer's machine, never part of the product.
.codex/

# Release planning scratch written by the coding agent during a release. The
# commits and CLAUDE.md are the durable record; these are working notes.
.claude/vivekium-release/
