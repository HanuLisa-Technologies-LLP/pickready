# Defense-in-depth on top of .gitignore (which graphify already respects by
# default). Explicit here so the exclusion is visible and doesn't silently
# depend on .gitignore never changing shape.

# Secrets and credentials
.env
.env.*
!.env.example
secrets/
**/*-keys.txt
**/*service-account*.json
**/gcp-key*.json
application_default_credentials.json
*.pem
*.tfvars
*.tfstate
*.tfstate.*

# Candidate/PII-shaped data — demo resumes carry real names even though the
# tenants are synthetic (see claude.md's 2026-08-05 seed-fixtures section)
backend/demo_resumes/

