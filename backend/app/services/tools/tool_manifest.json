      "input_schema": {
        "additionalProperties": false,
        "description": "Ask the context engine for the pieces of a document bearing on a query.\n\n`source_ids` is required rather than optional, and that is the important\nfield. An unscoped semantic search over the chunk table would happily return\nanother candidate's resume paragraph: RLS keeps it inside the tenant, and\nnothing but this scoping keeps it to the person being assessed.",
        "properties": {
          "exclude_answer_message_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 200,
            "title": "Exclude Answer Message Ids",
            "type": "array"
          },
          "max_tokens": {
            "default": 2000,
            "maximum": 8000,
            "minimum": 100,
            "title": "Max Tokens",
            "type": "integer"
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "section_types": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Section Types",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 20,
            "minimum": 1,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "source_type",
          "source_ids"
        ],
        "title": "RetrievalRequest",
        "type": "object"
      },
      "name": "retrieve_context",
      "output_schema": {
        "$defs": {
          "RetrievedPiece": {
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "format": "uuid",
                "title": "Chunk Id",
                "type": "string"
              },
              "content": {
                "title": "Content",
                "type": "string"
