        "additionalProperties": false,
        "description": "Ask the tool layer whether a generated payload is shaped correctly.\n\nA tool rather than a helper function because it is the one piece of\nverification an agent may invoke on ITSELF mid-task, and routing it through\nthe executor means that self-check is counted and bounded like every other\ncall rather than being invisible work inside a prompt loop.",
        "properties": {
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Payload"
          },
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          }
        },
        "required": [
          "schema_name",
          "payload"
        ],
        "title": "ValidationRequest",
        "type": "object"
      },
