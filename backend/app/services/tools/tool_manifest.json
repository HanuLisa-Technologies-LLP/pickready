    {
      "digest": "07f34e467698b25f8896fea38011a10e789007b158c3306ed227c63ed2e39e9a",
      "granted_to": [
        "interviewer",
        "ppi_report",
        "probe",
        "ranking",
        "scoring"
      ],
      "input_schema": {
        "additionalProperties": false,
        "description": "Ask the context engine for the pieces of a document bearing on a query.\n\n`source_ids` is required rather than optional, and that is the important\nfield. An unscoped semantic search over the chunk table would happily return\nanother candidate's resume paragraph: RLS keeps it inside the tenant, and\nnothing but this scoping keeps it to the person being assessed.",
        "properties": {
          "max_tokens": {
            "default": 2000,
            "maximum": 8000,
            "minimum": 100,
            "title": "Max Tokens",
            "type": "integer"
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "section_types": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Section Types",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 20,
            "minimum": 1,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "source_type",
          "source_ids"
        ],
        "title": "RetrievalRequest",
        "type": "object"
      },
      "name": "retrieve_context",
      "output_schema": {
        "$defs": {
          "RetrievedPiece": {
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "format": "uuid",
                "title": "Chunk Id",
                "type": "string"
              },
              "content": {
                "title": "Content",
                "type": "string"
              },
              "retrievers": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Retrievers",
                "type": "array"
              },
              "section_type": {
                "title": "Section Type",
                "type": "string"
              },
              "source_id": {
                "format": "uuid",
                "title": "Source Id",
                "type": "string"
              },
              "source_type": {
                "title": "Source Type",
                "type": "string"
              }
            },
            "required": [
              "chunk_id",
              "source_type",
              "source_id",
              "section_type",
              "content"
            ],
            "title": "RetrievedPiece",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "compressed": {
            "default": false,
            "title": "Compressed",
            "type": "boolean"
          },
          "dropped": {
            "default": 0,
            "title": "Dropped",
            "type": "integer"
          },
          "pieces": {
            "default": [],
            "items": {
              "$ref": "#/$defs/RetrievedPiece"
            },
            "title": "Pieces",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "text": {
            "default": "",
            "title": "Text",
            "type": "string"
          },
          "tokens": {
            "default": 0,
            "title": "Tokens",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "RetrievedContext",
        "type": "object"
      },
      "risk": "read"
    },
