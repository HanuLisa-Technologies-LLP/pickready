            },
            "title": "Errors",
            "type": "array"
          },
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "schema_name",
          "valid"
        ],
        "title": "ValidationVerdict",
        "type": "object"
      },
      "risk": "read"
    }
