      "name": "extract_assessment",
      "output_schema": {
        "$defs": {
          "Exchange": {
            "additionalProperties": false,
            "description": "One question and the answer filed under it.\n\nPaired SERVER-SIDE, and the follow-up rule is why: a probe reuses its\nparent's `question_key`, which is exactly how the scorers file it. Pairing\nper caller would reimplement that rule and let it drift.",
            "properties": {
              "answer": {
                "title": "Answer",
                "type": "string"
              },
              "answer_label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Answer Label"
              },
              "domain": {
                "title": "Domain",
                "type": "string"
              },
              "question": {
                "title": "Question",
                "type": "string"
              },
              "question_key": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Question Key"
              }
            },
            "required": [
              "domain",
              "question",
              "answer"
            ],
            "title": "Exchange",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Conversation Id"
          },
          "exchanges": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Exchange"
            },
            "title": "Exchanges",
            "type": "array"
          },
          "grade": {
            "title": "Grade",
            "type": "string"
          },
          "link_id": {
            "format": "uuid",
            "title": "Link Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "truncated": {
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "link_id",
          "status",
          "grade"
        ],
        "title": "AssessmentFacts",
        "type": "object"
      },
      "risk": "read"
    },
