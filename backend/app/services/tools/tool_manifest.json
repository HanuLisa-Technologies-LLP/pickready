        },
        "additionalProperties": false,
        "properties": {
          "compressed": {
            "default": false,
            "title": "Compressed",
            "type": "boolean"
          },
          "dropped": {
            "default": 0,
            "title": "Dropped",
            "type": "integer"
          },
          "pieces": {
            "default": [],
            "items": {
              "$ref": "#/$defs/RetrievedPiece"
            },
            "title": "Pieces",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "text": {
            "default": "",
            "title": "Text",
            "type": "string"
          },
          "tokens": {
            "default": 0,
