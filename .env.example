# PickReady — backend environment template (production sprint: Firebase auth + SMTP email).
# Copy to .env and fill in real values. NEVER commit real secrets — placeholders only.
# docker-compose reads this file (env_file: ../.env) for backend, worker, and beat.

# Database
DATABASE_URL=postgresql+asyncpg://pickready:pickready@localhost:5432/pickready
POSTGRES_RLS_APP_ROLE=pickready_app

# Redis. Cache, rate limiting, the proctoring warning counter and the background
# run-status record. NOT a message broker: nothing publishes to or consumes from
# a queue in it (see docs/spec/BACKGROUND_WORK.md).
REDIS_URL=redis://localhost:6379/0

# WHERE BACKGROUND WORK RUNS. Three real deployments, never a fallback chain:
#   aws     invoke Lambda; long work becomes one on-demand Fargate task.
#           Staging and production.
#   local   run the task in a thread in this process. The compose stack, which
#           has no Lambda. NOTE: the periodic sweeps do not run under `local`;
#           a laptop has no scheduler. See docs/spec/BACKGROUND_WORK.md.
#   record  accept the dispatch, run nothing, remember it. The test suite.
#           Refused outright in production by the dispatcher itself.
TASK_DISPATCH_BACKEND=local

# Job setup. Hours a Sutra skills draft may sit unsaved before the people who
# can save it get one reminder (pickready.remind_unsaved_skills), and minutes a
# dispatched Job SWOT generation may stay "generating" before it reads as
# failed.
SKILLS_SETUP_REMINDER_HOURS=48
SWOT_GENERATION_STALE_MINUTES=5

# Auth — JWT (app session cookies) + Firebase (primary login for ALL roles)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Firebase Admin service-account credentials as a SINGLE-LINE JSON string
# (the whole serviceAccountKey.json, minified). Backend verifies Firebase ID
# tokens with this at POST /auth/firebase/session. Required for Firebase login.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OTP (legacy/manual channel — Firebase is the primary login now, but the
# MSG91 SMS OTP send-path is kept alive and manually testable)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=15

# -- Models and embeddings ----------------------------------------------------
#
# THREE CREDENTIALS, PLATFORM-WIDE, ONE PER MODEL. This replaced a 21-slot
# roster (7 keys each for Groq, Gemini and OpenRouter) plus a dynamic capacity
# scheduler. All of that existed to route around three FREE tiers' failure
# modes: a retired model id, an exhausted prepaid balance, an
# 8000-token-per-minute organisation pool, and a model withdrawn from the free
# tier outright. One paid vendor removes the class of problem, so it removes
# the machinery.
#
# THE MODEL VENDOR CHANGED ON 2026-08-31, from Anthropic to OpenAI, by owner
# decision. This reverses a rule that was written down in three places, and all
# three were changed with the code rather than left contradicting it. What was
# reversed is the VENDOR; the single-vendor discipline is unchanged, and
# ANTHROPIC_API_KEY is gone rather than kept as a fallback. The embedding VENDOR
# did not change; the variable its key is read from did, so that every
# credential here is named after the model it unlocks.
#
# In a deployed environment all three are mounted from AWS Secrets Manager and
# never composed into a loggable env var, continuing the discipline established
# when DATABASE_URL was hardened.
#
# Everything runs on exactly three endpoints and nothing else:
#   reasoning / writing / judgment  ->  gpt-5.6-terra
#   extraction / classification     ->  gpt-5.6-luna
#   every embedding                 ->  voyage-4
# Which task uses which is DATA in backend/app/config/llm_providers.py, and the
# two tiers are never crossed: the extraction model must not evaluate.
#
# The two model ids are UNVERIFIED. There is no OpenAI key in this phase, so
# neither has been resolved against a models endpoint. See VERIFICATION_PENDING.md.
OPENAI_GPT_TERRA=
OPENAI_GPT_LUNA=
# The KEY is named after the intent; the MODEL is voyage-4. Those differ
# because voyage-context-4 turned out not to exist: Voyage returns 400
# naming its supported list. Verified live 2026-08-31.
VOYAGE_CONTEXT_4=

# The RERANKER's key, named after the model it unlocks (rerank-2.5), the same
# convention as the line above and as OPENAI_GPT_TERRA. Where the Voyage account
# issues one key it is the same string; a separate variable is what makes "the
# reranker is not configured" a RECORDED degradation rather than an embedding
# outage wearing a reranker's name.
VOYAGE_RERANK_2_5=

# Retrieval feature flags (RPN-AI-UP-001 W6). Deployment data: ONE value per
# deployment, never a fallback chain, the same shape as TASK_DISPATCH_BACKEND
# and EMAIL_TRANSPORT. An unrecognised value RAISES rather than defaulting,
# because the failure mode of a wrong one is silent -- retrieval keeps working
# and simply gets worse, which is indistinguishable from a tenant with thin
# evidence.
#
# `lexical` is the default deliberately: an environment that has not made the
# decision runs the behaviour it runs today, and turning the cross-encoder on is
# an explicit act.
RETRIEVAL_RERANKER=lexical      # voyage | lexical
RETRIEVAL_CONTEXTUAL_PREFIX=true

# OpenTelemetry GenAI (RPN-AI-UP-001 W4.6). UNSET MEANS EXPORT IS OFF, which is
# what local development and the test suite run with. Set the endpoint to turn
# on OTLP/HTTP export of the gen_ai spans and the two gen_ai.client.* histograms.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=readypick-backend
# NO_CONTENT in every deployed environment. Read by third-party GenAI
# instrumentation, NOT by services/observability/otel.py: that module carries an
# allowlist and cannot emit content whatever this is set to. Declared here so a
# library added later inherits the rule instead of defaulting into it. A trace
# store is read by far more people than the database, and the content is
# candidate answers, resumes and job descriptions.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Decrypts historical `llm_provider_keys` rows. The router no longer reads that
# table; the rows were kept rather than dropped so a rollback needs no restore.
LLM_KEY_ENCRYPTION_SECRET=

# Web search: Tavily, used by the BD Portal's AI Reach agent. OPTIONAL:
# without it the "from the internet" segment returns an empty result with a
# plain message and the "similar to our customers" segment still works.
TAVILY_API_KEY=

# Project Evidence Intelligence. OPTIONAL: raises the public GitHub API rate
# limit for candidate repository ingestion. It grants no private-repository
# access and no private path exists for it to widen; public repositories only,
# by product decision. Processing limits are PROJECT_* settings with safe
# defaults in app/core/config.py and need no entries here.
GITHUB_API_TOKEN=

# -- Proctoring: the analysis service (analysis-service/) --------------------
#
# Speaker counting over a fifteen-second audio chunk, and an AI-text estimate
# that ships disabled. A separate container from the backend, on port 8100:
# it carries torch and the model libraries the API and worker never load, and
# the audio chunk is the one media type that leaves a candidate's browser.
# The chunk is decoded in memory and destroyed; nothing writes it anywhere.
#
# EMPTY MEANS AUDIO ANALYSIS IS UNAVAILABLE, and the proctoring report says so
# in those words. It is never read as "no second voice was heard". The compose
# stack sets this for you; in a deployed environment it is a Cloud Map name
# that resolves inside the VPC only, set by the Terraform.
PROCTORING_ANALYSIS_SERVICE_URL=

# The Hugging Face token the analysis service loads the diarization models
# with. They are GATED: accept the conditions at
# huggingface.co/pyannote/speaker-diarization-3.1 AND
# huggingface.co/pyannote/segmentation-3.0 on the account this token belongs
# to, then create a READ token at huggingface.co/settings/tokens. Without one
# the service still starts and reports diarization unavailable at /health.
#
# Read by the ANALYSIS SERVICE, not by the backend, at runtime as well as at
# image build (the build takes it as a Docker secret, never a build ARG). In a
# deployed environment it is mounted from AWS Secrets Manager and only the
# analysis service's IAM policy can read it. See analysis-service/README.md.
HUGGINGFACE_TOKEN=

# AI-generated-text detection. OFF, and the default is the decision: the
# detectors are unreliable against current language models, so the estimate is
# informational only and never contributes to a warning, a termination, a
# score or a ranking. Turning it on adds a hedged sentence to the report and
# nothing else. The analysis service has its own AI_TEXT_ENABLED flag; this
# one governs whether the backend asks at all.
PROCTORING_AI_TEXT_DETECTION_ENABLED=false

# -- The assessment turn clock and spoken answers ------------------------------
#
# The SERVER times every turn (Appendix B): prose 3 minutes, multiple choice
# and fill-in-the-blank 60 seconds, a follow-up 100 seconds, coding 20
# minutes. A turn past its time plus the grace is submitted by the server with
# the candidate's last saved draft; an empty one is an evidence gap. Each turn
# snapshots its allocation when it opens, so changing these never moves a
# deadline somebody is already answering against.
ASSESSMENT_TIME_PROSE_SECONDS=180
ASSESSMENT_TIME_OBJECTIVE_SECONDS=60
ASSESSMENT_TIME_FOLLOW_UP_SECONDS=100
ASSESSMENT_TIME_CODING_SECONDS=1200
ASSESSMENT_SUBMIT_GRACE_SECONDS=5
# How long a start waits before asking for question generation again while a
# candidate's questions are still being prepared (generation is a Fargate task).
ASSESSMENT_QUESTION_REDISPATCH_SECONDS=600
# Spoken answers: at most three minutes, transcribed by Amazon Transcribe
# (TRANSCRIBE_ENABLED). Transcribe disabled means the microphone control is
# not offered and every answer is typed; it is never a fake transcript.
ASSESSMENT_VOICE_MAX_SECONDS=180
ASSESSMENT_VOICE_MAX_BYTES=6291456
ASSESSMENT_VOICE_TRANSCRIBE_TIMEOUT_SECONDS=120
ASSESSMENT_VOICE_TRANSCRIBE_POLL_SECONDS=3
ASSESSMENT_VOICE_FAILURE_PAUSE_SECONDS=30
# The consent every candidate accepts before starting. One text, one version;
# a change to the wording is a change to the version.
ASSESSMENT_CONSENT_VERSION=2026-09-24

# -- Code execution (the coding question sandbox) -------------------------------
#
# Candidate code NEVER runs in the API, a worker, a Lambda or any container
# that holds an application secret. It runs in a self-hosted Judge0 CE sandbox
# on its own host (infra/modules/code_sandbox), reached over the VPC.
#
# ONE BACKEND, NEVER A FALLBACK CHAIN: "judge0" or "disabled". DISABLED IS THE
# DEFAULT AND A REAL STATE: coding questions are not offered and every surface
# says code execution is unavailable. The test double is not a value here.
CODE_EXECUTION_BACKEND=disabled
# The languages a coding question may be written in (python, java, cpp,
# javascript). An unknown key refuses to boot.
CODE_EXECUTION_LANGUAGES=python,java,cpp,javascript
# Per-run limits sent with every submission. The sandbox host carries its own
# MAX_* caps above these; a limit above a cap is refused, never clamped.
CODE_EXECUTION_CPU_SECONDS=2.0
CODE_EXECUTION_CPU_EXTRA_SECONDS=0.5
CODE_EXECUTION_WALL_SECONDS=5.0
CODE_EXECUTION_MEMORY_MB=256
CODE_EXECUTION_STACK_KB=65536
CODE_EXECUTION_MAX_PROCESSES=60
CODE_EXECUTION_MAX_FILE_KB=1024
CODE_EXECUTION_MAX_OUTPUT_CHARS=4000
CODE_EXECUTION_CPU_MULTIPLIERS=java:2.0,javascript:1.5
CODE_EXECUTION_CONNECT_TIMEOUT_SECONDS=2.0
CODE_EXECUTION_REQUEST_TIMEOUT_SECONDS=5.0
CODE_EXECUTION_POLL_SECONDS=0.5
# The sandbox address inside the VPC, e.g. http://judge0.readypick.local:2358.
# Empty means code execution is unavailable; it is NOT a boot refusal.
JUDGE0_URL=
# Mounted from Secrets Manager as <project>-<environment>/JUDGE0_AUTH_TOKEN in
# a deployed environment. Never logged.
JUDGE0_AUTH_TOKEN=
# Adapter-only language ids, checked against the sandbox's GET /languages.
JUDGE0_LANGUAGE_IDS=python:71,java:62,cpp:54,javascript:63

# Email — Gmail SMTP only. Use a Google App Password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vivekium
SMTP_STARTTLS=true
SMTP_SSL=false

# Outbound email transport (Corporate Email System spec, 2026-09-05).
# ONE transport per deployment, never a fallback chain: "smtp" (default, the
# Gmail path above) or "ses" (Amazon SES via the task role; no key here).
EMAIL_TRANSPORT=smtp
# The SNS topic SES publishes delivery/bounce/complaint events to. Empty means
# the /email-senders/events/ses webhook refuses everything (correct for SMTP).
SES_SNS_TOPIC_ARN=

# Candidate message notifications. A burst of recruiter messages produces ONE
# email and Updates entry; the next waits this many minutes unless the
# candidate has read the thread since. 0 notifies on every message.
CANDIDATE_MESSAGE_NOTIFY_DEBOUNCE_MINUTES=10

# Corporate sender registration (Corporate Email System spec, 2026-09-05).
# Free/personal providers may never be registered as a corporate sender; this
# comma-separated list REPLACES the built-in default (app/core/config.py)
# when set, so include everything you want blocked. Unset keeps the default.
#SENDER_DOMAIN_BLOCKLIST=gmail.com,yahoo.com,outlook.com
# Mailbox-ownership OTP: TTL inside the spec's 5-10 minute window, 3 attempts,
# 45-second resend cooldown.
SENDER_OTP_TTL_SECONDS=600
SENDER_OTP_MAX_ATTEMPTS=3
SENDER_OTP_RESEND_COOLDOWN_SECONDS=45

# SMS — MSG91 (retained as a manually-tested feature; NOT the login path)
MSG91_API_KEY=
MSG91_SENDER_ID=PCKRDY

# -- Private file storage: S3 (spec-doc5 Part D) -----------------------------
#
# Resumes, work-sample artefacts, PRISM attachments and evidence-graph source
# documents. Objects are CONTENT-ADDRESSED by sha256, and durable database
# values are `s3://bucket/key` references -- a raw bucket URL is never returned
# to a browser. Reads pass through an authenticated, tenant-scoped,
# capability-checked endpoint rather than a presigned link, because a presigned
# URL is a bearer token that leaves no audit trail once it is copied.
#
# NO ACCESS KEY BELONGS HERE. boto3 resolves the ECS task role, which the
# Terraform in infra/ scopes to exactly this bucket. A long-lived key in an env
# var is what that scoping exists to avoid.
S3_BUCKET=
AWS_REGION=ap-south-1
# Localstack / MinIO only. Leave blank everywhere real.
S3_ENDPOINT_URL=
RESUME_SIGNED_URL_TTL_SECONDS=300

# Payments — Razorpay Subscriptions (recurring monthly billing).
# RAZORPAY_KEY_ID is public: it is handed to Razorpay Checkout in the browser.
# The frontend reads it from GET /billing/config rather than a build-time
# NEXT_PUBLIC_ variable, so the frontend container never needs this file.
# RAZORPAY_KEY_SECRET is server-side only — it signs subscription creation and
# verifies checkout signatures, and must never reach the frontend bundle.
# RAZORPAY_WEBHOOK_SECRET is the separate secret configured on the Razorpay
# dashboard webhook; it verifies the X-Razorpay-Signature header. Leave it blank
# only in local development, where webhook verification is skipped with a
# WARNING rather than accepting an unverified payload in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Per-request `Server-Timing`, `X-Query-Count` and the `X-Debug-SQL: 1` request
# header that logs every statement a request ran. On here because that is what
# a laptop wants; OFF everywhere else, including the pilot, and it is NOT
# derived from ENVIRONMENT.
#
# It used to be, via `not is_production`, and that gate was OPEN on the live
# site: `is_production` means `ENVIRONMENT == "production"` and the deployment
# serving readypick.ai runs `ENVIRONMENT=pilot`. Anything whose danger depends
# on real users being present has to be set per deployment rather than inferred
# from a release-channel name.
EXPOSE_REQUEST_DIAGNOSTICS=true

# ---------------------------------------------------------------------------
# Google Cloud Run deployment (infra/gcp/deploy.sh, docs/DEPLOY_GCP.md)
# ---------------------------------------------------------------------------
# Only POSTGRES_PASSWORD is required and it is used ONLY by the deploy script,
# to create the Cloud SQL user. The application never reads it: it receives a
# complete DATABASE_URL, which the script assembles as a unix-socket DSN,
#   postgresql+asyncpg://USER:PASS@/pickready?host=/cloudsql/CONNECTION_NAME
# because --add-cloudsql-instances mounts a socket and there is no host:port to
# connect to. Leave blank for local development.
POSTGRES_PASSWORD=

# Deployment target. All optional; the defaults below are what deploy.sh uses.
GCP_PROJECT_ID=pick-ready-503913
GCP_REGION=asia-south1
GCP_KEY_FILE=service-account-key.json
# SQL_TIER=db-custom-1-3840
# REDIS_SIZE=1

# ---------------------------------------------------------------------------
# Frontend runtime (set on the Cloud Run frontend service, not in this file)
# ---------------------------------------------------------------------------
# BACKEND_INTERNAL_URL is where the same-origin API proxy
# (frontend/app/api/[...path]/route.ts) forwards /api/*. It is read per REQUEST,
# never inlined into the bundle, so one frontend image is valid in every
# environment. The browser never sees it.
#
# It is deliberately not NEXT_PUBLIC_: keeping the browser on a single origin is
# what allows COOKIE_SAMESITE to stay "strict". Two Cloud Run services are
# cross-site (*.a.run.app is on the Public Suffix List), so a split origin makes
# the browser drop every auth cookie and nobody can stay signed in.
#
# Setting NEXT_PUBLIC_API_URL overrides the proxy and opts into that split-origin
# mode, which then also requires COOKIE_SAMESITE=none. Leave it unset.
#   BACKEND_INTERNAL_URL=http://backend:8000     (compose sets this for you)
#
# The six NEXT_PUBLIC_FIREBASE_* values live in frontend/.env.local and are
# inlined at BUILD time, so they are passed as --build-arg. They are public by
# design and are not secrets.
#
# NEXT_PUBLIC_LANDING_LIVE is the LAUNCH GATE for the marketing landing page.
# "true" makes / serve the landing page; anything else, unset included, keeps
# the "Site Under Construction" holding page. It is inlined at BUILD time like
# the Firebase values, so flipping it needs a rebuild, and it defaults OFF so a
# deployment that says nothing keeps serving the holding page.
#   NEXT_PUBLIC_LANDING_LIVE=false
