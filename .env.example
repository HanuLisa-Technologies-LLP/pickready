# PickReady — backend environment template (production sprint: Firebase + Mailtrap).
# Copy to .env and fill in real values. NEVER commit real secrets — placeholders only.
# docker-compose reads this file (env_file: ../.env) for backend, worker, and beat.

# Database
DATABASE_URL=postgresql+asyncpg://pickready:pickready@localhost:5432/pickready
POSTGRES_RLS_APP_ROLE=pickready_app

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth — JWT (app session cookies) + Firebase (primary login for ALL roles)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Firebase Admin service-account credentials as a SINGLE-LINE JSON string
# (the whole serviceAccountKey.json, minified). Backend verifies Firebase ID
# tokens with this at POST /auth/firebase/session. Required for Firebase login.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OTP (legacy/manual channel — Firebase is the primary login now, but the
# MSG91 SMS OTP send-path is kept alive and manually testable)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=15

# LLM providers (3 each, router picks/falls back per ESD §8.4)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
LLM_KEY_ENCRYPTION_SECRET=

# Embeddings
BGE_M3_ENDPOINT=

# Email — Mailtrap Sending API (REPLACES Resend for ALL outbound email).
# RESEND_API_KEY is deprecated and no longer read by the app.
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER_EMAIL=noreply@pickready.app
MAILTRAP_SENDER_NAME=PickReady
# Sending API host (real delivery). Leave as-is for production.
MAILTRAP_API_HOST=send.api.mailtrap.io
# Optional: set MAILTRAP_INBOX_ID to route through a Testing/sandbox inbox in
# dev instead of real delivery (uses sandbox.api.mailtrap.io + /api/send/<id>).
MAILTRAP_INBOX_ID=
# RESEND_API_KEY=  # DEPRECATED — Mailtrap replaced Resend (claude.md rule 5)

# SMS — MSG91 (retained as a manually-tested feature; NOT the login path)
MSG91_API_KEY=
MSG91_SENDER_ID=PCKRDY

# File storage — Cloudinary (resume uploads; seeded sample resumes)
CLOUDINARY_URL=

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
