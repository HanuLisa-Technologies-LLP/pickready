# PickReady — backend environment template (production sprint: Firebase auth + SMTP email).
# Copy to .env and fill in real values. NEVER commit real secrets — placeholders only.
# docker-compose reads this file (env_file: ../.env) for backend, worker, and beat.

# Database
DATABASE_URL=postgresql+asyncpg://pickready:pickready@localhost:5432/pickready
POSTGRES_RLS_APP_ROLE=pickready_app

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth — JWT (app session cookies) + Firebase (primary login for ALL roles)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Firebase Admin service-account credentials as a SINGLE-LINE JSON string
# (the whole serviceAccountKey.json, minified). Backend verifies Firebase ID
# tokens with this at POST /auth/firebase/session. Required for Firebase login.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OTP (legacy/manual channel — Firebase is the primary login now, but the
# MSG91 SMS OTP send-path is kept alive and manually testable)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=15

# LLM providers (3 each, router picks/falls back per ESD §8.4)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
LLM_KEY_ENCRYPTION_SECRET=

# Embeddings
BGE_M3_ENDPOINT=

# Email — SMTP from the backend (provider-agnostic; PRD v1.0, as of 2026-07-24).
# All outbound email (OTP, outreach, verification, interview invites) is sent over
# SMTP directly by the FastAPI backend / Celery worker — no HTTP email API. The
# same code works with ANY SMTP provider, e.g.:
#   * Mailtrap SMTP  — host live.smtp.mailtrap.io (real) or sandbox.smtp.mailtrap.io
#     (testing inbox); SMTP_USER/SMTP_PASSWORD from the Mailtrap SMTP credentials.
#   * Gmail SMTP     — host smtp.gmail.com, SMTP_USER = the Gmail address,
#     SMTP_PASSWORD = a Google *App Password* (not the account password; requires 2FA).
# TLS modes:
#   * STARTTLS (the common case) → SMTP_PORT=587, SMTP_STARTTLS=true,  SMTP_SSL=false
#   * Implicit TLS/SSL           → SMTP_PORT=465, SMTP_STARTTLS=false, SMTP_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pickready.app
SMTP_FROM_NAME=PickReady
SMTP_STARTTLS=true
SMTP_SSL=false
# DEPRECATED — the Mailtrap Sending API (HTTP) and Resend are no longer the email
# path; SMTP above replaces them (claude.md rule 5, PRD v1.0). Left unset. The
# MAILTRAP_* config keys still exist in code for backward-compat but are not the
# active sender; do not rely on them.
# MAILTRAP_API_TOKEN=   # DEPRECATED — replaced by SMTP_*
# RESEND_API_KEY=       # DEPRECATED — replaced by SMTP_* (was already replaced by Mailtrap)

# SMS — MSG91 (retained as a manually-tested feature; NOT the login path)
MSG91_API_KEY=
MSG91_SENDER_ID=PCKRDY

# File storage — Cloudinary (resume uploads; seeded sample resumes)
CLOUDINARY_URL=

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
